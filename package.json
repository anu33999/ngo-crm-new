{
  "name": "kreatif-ngo-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ingest": "python3 -I scripts/ingest_reference.py",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:verify": "tsx scripts/verify-seed.ts",
    "db:setup": "prisma migrate dev --name init && prisma db seed && npm run db:verify",
    "db:use-postgres": "node scripts/use-postgres.mjs",
    "setup": "node scripts/setup.mjs",
    "go": "node scripts/setup.mjs && next dev",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@react-pdf/renderer": "^4.9.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "prisma": "6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "robots-parser": "^3.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
