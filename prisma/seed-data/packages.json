  "quoteBuilder": {
    "defaultTier": "Gold",
    "defaultMonths": 12,
    "instruction": "EDIT ONLY THE YELLOW CELLS: the tier in B4, the months in B6, and a quantity in column E below. Every other cell is a formula.",
    "footnote": "All figures exclude GST. Media spend, WhatsApp message fees, printing, venue, travel, flight permissions, hosting and software licences are additional and funded by the NGO.",
    "formulas": {
      "monthlyRetainer": "price of selected tier",
      "recurringAddOnsPerMonth": "sum(unit price x qty) for category Recurring",
      "oneTimeSetup": "sum(unit price x qty) for category Setup",
      "projects": "sum(unit price x qty) for category Project",
      "month1Invoice": "retainer + recurring + setup + projects",
      "ongoingMonthlyInvoice": "retainer + recurring",
      "totalContractValue": "(retainer + recurring) x months + setup + projects"
    }
  },
